# Runtime production configuration for docker-compose.yml.
# Copy this file to .env.production on the deployment server and replace every placeholder.
# NODE_ENV, PORT and DECISION_MODELS_SERVICE_BASE_URL are set as container-internal values in compose.

MONGODB_URI=<mongodb_connection_uri>
MONGODB_DB_NAME=<mongodb_database_name>

JWT_SECRET=<jwt_secret>
JWT_REFRESH=<jwt_refresh_secret>

ORIGIN_FRONT=<frontend_public_origin>
ORIGIN_BACK=<backend_public_origin>
ORIGIN_CRETEVALLEY=<crete_valley_public_origin>
ORIGIN_SULEIMAN=<external_suleiman_origin>

CRETEVALLEY_EMAIL=<notification_email>
APIKEY_BREVO=<brevo_api_key>

MODEL_FORGE_BASE_URL=<optional_model_forge_base_url>
