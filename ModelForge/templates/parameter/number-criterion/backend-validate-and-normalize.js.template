import { normalizeNumberValue } from "../../../../modelParameters/parameterValues.js";
import { hasOwnKey, isPlainObject } from "../../../../../utils/common/objects.js";
import { toInvalid, toValid } from "../../parameterValidationResult.js";

const normalizeId = (value) => typeof value === "string" && value.trim() ? value.trim() : null;

export const validateAndNormalizeNumberCriterion = ({ value, parameter, context }) => {
  const criteria = context?.leafCriteria;
  if (!Array.isArray(criteria) || criteria.length === 0) return toInvalid("requires at least one leaf criterion", value);
  const rows = [];
  const ids = new Set();
  for (const criterion of criteria) {
    const id = normalizeId(criterion?.id);
    if (!id) return toInvalid("leaf criteria must include canonical ids", value);
    if (ids.has(id)) return toInvalid(`contains duplicate criterion id '${id}'`, value);
    ids.add(id);
    rows.push({ id, name: normalizeId(criterion?.name) || id });
  }
  const restrictions = parameter?.restrictions || {};
  const normalize = (rawValue, name) => {
    const normalized = normalizeNumberValue(rawValue);
    if (normalized === null) return toInvalid("must be a finite number", rawValue);
    if ((restrictions.min !== null && normalized < restrictions.min) || (restrictions.max !== null && normalized > restrictions.max)) return toInvalid(`[${name}] must satisfy the declared range`, rawValue);
    return toValid(normalized);
  };
  if (!isPlainObject(value)) {
    const normalized = normalize(value, rows[0].name);
    if (!normalized.ok) return normalized;
    return toValid(Object.fromEntries(rows.map((row) => [row.id, normalized.value])));
  }
  for (const key of Object.keys(value)) if (!normalizeId(key) || !ids.has(key)) return toInvalid(`contains unknown criterion key '${key}'`, value[key]);
  const result = {};
  for (const row of rows) {
    if (!hasOwnKey(value, row.id)) return toInvalid(`is missing value for criterion '${row.id}'`, value);
    const normalized = normalize(value[row.id], row.name);
    if (!normalized.ok) return normalized;
    result[row.id] = normalized.value;
  }
  return toValid(result);
};
